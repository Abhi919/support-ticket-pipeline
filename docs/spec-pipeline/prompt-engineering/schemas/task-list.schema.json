{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskList",
  "type": "object",
  "required": ["ticketId", "specRevision", "tasks"],
  "properties": {
    "ticketId": { "type": "string" },
    "specRevision": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "acceptanceCriteria", "verification", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^T-[0-9]{3}$" },
          "description": { "type": "string", "minLength": 10 },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
            "minItems": 1
          },
          "nonFunctional": {
            "type": "array",
            "items": { "type": "string", "pattern": "^NFR-[0-9]{3}$" }
          },
          "verification": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "done", "blocked", "cancelled"]
          }
        }
      }
    }
  }
}
